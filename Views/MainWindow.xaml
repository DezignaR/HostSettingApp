<Window 
    x:Class="WpfApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:vm="clr-namespace:WpfApp1.ViewModels"
    mc:Ignorable="d"
    Title="Custom Window" Height="450" Width="800"
    WindowStyle="None" 
    WindowStartupLocation="Manual"
    Top="0"
    AllowsTransparency="True" 
    Background="Transparent">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <!-- Шапка окна -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
            </Grid.RowDefinitions>

        <!-- Пользовательская шапка -->
            <Grid Grid.Row="0"  Background="#2D2D2D">
                <!--MouseLeftButtonDown="Header_MouseLeftButtonDown">-->
                <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="White"/>

                <!-- Кнопки управления (Закрыть, Свернуть) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Click="Button_Click_Minimize" Width="25" Background="Transparent" Foreground="White"/>
                    <!--Click="Minimize_Click"-->
                    <Button Content="✕"  Click="Button_Click_Close"  Width="25" Background="Transparent" Foreground="White" />
                    
                </StackPanel>
            </Grid>

            <!-- Контент -->
            <Grid Grid.Row="1">
                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Margin="42,10,620,327">
                    <StackPanel Background="Transparent" Margin="7,7,7,7">
                        <TextBox x:Name="iphost" Text="{Binding newHostIp, Mode=TwoWay}"></TextBox>
                        <TextBox x:Name="maskhost" Text="{Binding newHostMask, Mode=TwoWay}" MouseDoubleClick="FillOut"></TextBox>
                        <Button Command="{Binding AddCommand}" Content="Добавить" Width="60" Height="20"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="AdapterListBox" ItemsSource="{Binding NetworkAdapters}" 
                         Margin="10,110,589,10" 
                         SelectedItem="{Binding SelectedAdapter}"
                         d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                         <DataTemplate>
                       
                            <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock  Text="{Binding}" FontWeight="Bold" Foreground="Green"/>
                                   
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Column="0"> 
                <ListBox x:Name="IpListBox" ItemsSource="{Binding PublicHost}"
                    Background="DimGray"
                    Margin="219,10,422,10"
                    SelectedItem="{Binding SelectedHost}">

                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete"
                                    Command="{Binding RemoveCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=IpListBox}"/>

                    </ListBox.InputBindings>
                    
                   <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Tag="{Binding ElementName=IpListBox}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Удалить"
                                                  Command="{Binding PlacementTarget.Tag.DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" Foreground="Red"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="Ping Host"
                                         Command="{Binding PlacementTarget.Tag.DataContext.PingHost, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                         CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" Foreground="Red"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                
                                <StackPanel Orientation="Horizontal" Margin="5">
                                   <TextBlock FontFamily="Segoe MDL2 Assets" 
                                    Text="&#xE839;" 
                                    FontSize="26" 
                                    Foreground="LightBlue" 
                                    Margin="5,0,10,0" 
                                    VerticalAlignment="Center"/>
                                    <StackPanel Height="40" >
                                        <TextBlock  Text="{Binding IPAddress}" FontWeight="Bold" Foreground="AliceBlue"/>
                                        <TextBlock  Text="{Binding SubnetMask}" Foreground="AliceBlue"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                   </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
                
                <Grid Grid.Column="1">
                    
                    <ListBox    x:Name="PingListBox" ItemsSource="{Binding PublicHost}"
                               
                                Background="DimGray"
                                Margin="399,10,242,10"
                                SelectedItem="{Binding SelectedHost}">

                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete"
                            Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=IpListBox}"/>

                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Tag="{Binding ElementName=IpListBox}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Удалить"
                                  Command="{Binding PlacementTarget.Tag.DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="Ping Host"
                         Command="{Binding PlacementTarget.Tag.DataContext.PingHost, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                         CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" 
                    Text="&#xE839;" 
                    FontSize="26" 
                    Foreground="LightBlue" 
                    Margin="5,0,10,0" 
                    VerticalAlignment="Center"/>
                                        <StackPanel Height="40" >
                                            <TextBlock  Text="{Binding IPAddress}" FontWeight="Bold" Foreground="AliceBlue"/>
                                            <TextBlock  Text="{Binding SubnetMask}" Foreground="AliceBlue"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
            
        </Grid>
    </Border>
</Window>
