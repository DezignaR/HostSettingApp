<Window 
    x:Class="WpfApp1.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:vm="clr-namespace:WpfApp1.ViewModels"
    xmlns:vw="clr-namespace:WpfApp1.Views"
    mc:Ignorable="d"
    Title="Custom Window" Height="450" Width="450"
    WindowStyle="None" 
    WindowStartupLocation="Manual"
    Top="0"
    AllowsTransparency="True" 
    Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Создаем невидимый мост, который будет держать ссылку на MainViewModel окна -->
        <vw:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="0,0,10,10" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <!-- ================================================================= -->
            <!-- РЕЖИМ 1: Основное окно приложения (Скрывается в режиме виджета) -->
            <!-- ================================================================= -->
            <Grid x:Name="MainAppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWidgetMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Пользовательская шапка -->
                <Grid Grid.Row="0" Background="#2D2D2D" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="White" Text="IP Manager"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗕" Click="Button_Click_Minimize" Width="25" Background="Transparent" Foreground="White" BorderThickness="0"/>
                        <Button Content="✕" Click="Button_Click_Close" Width="25" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- Контент списков -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="49*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Список адаптеров -->
                    <ListBox x:Name="AdapterListBox" 
                             ItemsSource="{Binding NetworkAdapters}" 
                             Margin="10,10,235,233" 
                             SelectedItem="{Binding SelectedAdapter}"
                             d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5">
                                    <StackPanel >
                                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="Green"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Список IP адресов -->
                    <ListBox x:Name="IpListBox" 
                             ItemsSource="{Binding PublicHost}"
                             Background="DimGray"
                             Margin="155,10,10,10"
                             SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                             Grid.IsSharedSizeScope="True"
                             Tag="{Binding ElementName=IpListBox}" Grid.ColumnSpan="2">

                        <!-- Контекстное меню самого списка -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Добавить новый IP"
                                          Command="{Binding PlacementTarget.Tag.DataContext.PrepareAddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE109;" Foreground="Green"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete"
                                        Command="{Binding RemoveCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=IpListBox}"/>
                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Background="Transparent" Margin="1">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                           <!--<MenuItem Header="Ping Host"
                                                      Command="{Binding Data.PingHost, Source={StaticResource VmProxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" Foreground="Orange"/>
                                                </MenuItem.Icon>
                                            </MenuItem>-->

                                            <MenuItem Header="Удалить"
                                                      Command="{Binding Data.RemoveCommand, Source={StaticResource VmProxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid Margin="5" Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="IpCol"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MaskCol"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка -->
                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" 
                                                   Text="&#xE839;" FontSize="24" Foreground="LightBlue" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Колонка IP -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtIp" Text="{Binding IPAddress}" FontWeight="Bold" Foreground="AliceBlue" FontSize="14"/>

                                            <TextBox x:Name="EditIp" 
                                                     Text="{Binding IPAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="130" Background="#2D2D2D" Foreground="White" BorderBrush="Gray" Visibility="Collapsed"
                                                     KeyDown="TextBox_KeyDown" />
                                        </Grid>

                                        <!-- Колонка Маски -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtMask" Text="{Binding SubnetMask}" Foreground="AliceBlue" FontSize="13"/>

                                            <TextBox x:Name="EditMask" 
                                                     Text="{Binding SubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="130" Background="#2D2D2D" Foreground="White" BorderBrush="Gray" Visibility="Collapsed"
                                                     KeyDown="TextBox_KeyDown" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="TxtIp" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="TxtMask" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="EditIp" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="EditMask" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ================================================================= -->
            <!-- РЕЖИМ 2: Маленький виджет-квадрат (Показывается вместо основного окна) -->
            <!-- ================================================================= -->
            <Border x:Name="WidgetContent" 
                    Background="#2D2D2D" 
                    CornerRadius="0,0,2,2" 
                    BorderBrush="Green" 
                    BorderThickness="1" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="Hand"
                    ToolTip="IP Manager свернут. Нажмите для восстановления.">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWidgetMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock FontFamily="Segoe MDL2 Assets" 
                           Text="&#xE70D;" 
                           FontSize="16" 
                           Foreground="LightGreen" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Top"/>
            </Border>
        </Grid>
    </Border>
</Window>