<Window x:Class="WpfApp1.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
    xmlns:vm="clr-namespace:WpfApp1.ViewModels"
    xmlns:vw="clr-namespace:WpfApp1.Views"
    mc:Ignorable="d"
    Title="Custom Window" Height="450" Width="450"
    WindowStyle="None" 
    WindowStartupLocation="Manual"
    Top="0"
    AllowsTransparency="True" 
    Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <vw:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="0,0,10,10" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid x:Name="MainAppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWidgetMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0" Background="#2D2D2D" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="White" Text="IP Manager"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗕" Click="Button_Click_Minimize" Width="25" Background="Transparent" Foreground="White" BorderThickness="0"/>
                        <Button Content="✕" Click="Button_Click_Close" Width="25" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- Контент -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="153*"/>
                        <ColumnDefinition Width="295*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список адаптеров -->
                    <ListBox x:Name="AdapterListBox" 
                             ItemsSource="{Binding NetworkAdapters}" 
                             Margin="10,10,5,55" 
                             SelectedItem="{Binding SelectedAdapter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Height="25" Width="124">
                                    <StackPanel>
                                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="Green"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Кнопка Refresh в виде иконки Segoe -->
                    <Button Grid.Column="0" Margin="10,0,5,10" VerticalAlignment="Bottom" Height="35"
                            Command="{Binding RefreshCommand}"
                            Background="#2D2D2D" BorderBrush="Gray" Foreground="White"
                            ToolTip="Обновить список адаптеров">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                   Text="&#xE72C;" 
                                   FontSize="16" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Button>
                    <!-- Список IP адресов / Хостов для пинга -->
                    <ListBox x:Name="IpListBox" 
                             ItemsSource="{Binding PublicHost}"
                             Background="DimGray"
                             Margin="5,10,10,10"
                             SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                             Tag="{Binding ElementName=IpListBox}" Grid.Column="1">

                        <!-- Контекстное меню самого списка -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Добавить элемент"
                                          Command="{Binding PlacementTarget.Tag.DataContext.PrepareAddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE109;" Foreground="Green"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete"
                                        Command="{Binding RemoveCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=IpListBox}"/>
                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Background="Transparent" Margin="1" HorizontalAlignment="Stretch">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ping"
                                                      Command="{Binding Data.StartPingCommand, Source={StaticResource VmProxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" Foreground="Green"/>
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsPinging}" Value="True"/>
                                                                    <Condition Binding="{Binding IsActivePinging}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="Отключить Ping"
                                                      Command="{Binding Data.StopPingCommand, Source={StaticResource VmProxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Foreground="Red"/>
                                                </MenuItem.Icon>
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActivePinging}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>

                                            <MenuItem Header="Изменить"
                                                      Command="{Binding Data.EditElementCommand, Source={StaticResource VmProxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE104;" Foreground="Yellow"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Удалить"
                                                      Command="{Binding Data.RemoveCommand, Source={StaticResource VmProxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid Margin="5" Width="240">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" 
                                                   Text="&#xE839;" FontSize="24" 
                                                   Foreground="{Binding StatusColor}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock x:Name="TxtIp" Text="{Binding IPAddress}" FontWeight="Bold" Foreground="AliceBlue" FontSize="14"/>
                                                <TextBox x:Name="EditIp" 
                                                         Text="{Binding IPAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="#2D2D2D" Foreground="White" BorderBrush="Gray" Visibility="Collapsed"
                                                         KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus" />
                                            </Grid>
                                            <Grid x:Name="MaskRow">
                                                <TextBlock x:Name="TxtMask" Text="{Binding SubnetMask}" Foreground="#CCCCCC" FontSize="12"/>
                                                <TextBox x:Name="EditMask" 
                                                         Text="{Binding SubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="#2D2D2D" Foreground="White" BorderBrush="Gray" Visibility="Collapsed"
                                                         KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    
                                    </Border>
                                        <DataTemplate.Triggers>

                                            <DataTrigger Binding="{Binding IsPinging}" Value="True">
                                                <Setter TargetName="MaskRow" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="TxtIp" Value="Collapsed" Property="Visibility"/>
                                                <Setter TargetName="TxtMask" Value="Collapsed" Property="Visibility"/>
                                                <Setter TargetName="EditIp" Value="Visible" Property="Visibility"/>
                                                <Setter TargetName="EditMask" Value="Visible" Property="Visibility"/>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                    <Condition Binding="{Binding IsPinging}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="EditMask" Value="Collapsed" Property="Visibility"/>
                                                <Setter TargetName="MaskRow" Value="Collapsed" Property="Visibility"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    
                                
                            </DataTemplate>
                               
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <Border x:Name="WidgetContent" 
                    Background="#2D2D2D" 
                    CornerRadius="0,0,2,2" 
                    BorderBrush="Green" 
                    BorderThickness="1" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="Hand"
                    ToolTip="IP Manager свернут. Нажмите для восстановления.">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWidgetMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock FontFamily="Segoe MDL2 Assets" 
                           Text="&#xE70D;" 
                           FontSize="16" 
                           Foreground="LightGreen" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Top"/>
            </Border>
        </Grid>
    </Border>
</Window>


