<Window 
    x:Class="WpfApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:vm="clr-namespace:WpfApp1.ViewModels"
    xmlns:vw="clr-namespace:WpfApp1.Views"
    mc:Ignorable="d"
    Title="Custom Window" Height="450" Width="800"
    WindowStyle="None" 
    WindowStartupLocation="Manual"
    Top="0"
    AllowsTransparency="True" 
    Background="Transparent">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Создаем невидимый мост, который будет держать ссылку на MainViewModel окна -->
        <vw:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <!-- Шапка окна -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
            </Grid.RowDefinitions>

        <!-- Пользовательская шапка -->
            <Grid Grid.Row="0"  Background="#2D2D2D">
                <!--MouseLeftButtonDown="Header_MouseLeftButtonDown">-->
                <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="White"/>

                <!-- Кнопки управления (Закрыть, Свернуть) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🗕" Click="Button_Click_Minimize" Width="25" Background="Transparent" Foreground="White"/>
                    <!--Click="Minimize_Click"-->
                    <Button Content="✕"  Click="Button_Click_Close"  Width="25" Background="Transparent" Foreground="White" />
                    
                </StackPanel>
            </Grid>

            <!-- Контент -->
            <Grid Grid.Row="1">
                
                <ListBox x:Name="AdapterListBox" ItemsSource="{Binding NetworkAdapters}" 
                         Margin="10,10,589,268" 
                         SelectedItem="{Binding SelectedAdapter}"
                         d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                         <DataTemplate>
                       
                            <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock  Text="{Binding}" FontWeight="Bold" Foreground="Green"/>
                                   
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Column="0">
                    <ListBox x:Name="IpListBox" 
         ItemsSource="{Binding PublicHost}"
         Background="DimGray"
         Margin="219,10,10,10"
         SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
         Grid.IsSharedSizeScope="True"
         Tag="{Binding ElementName=IpListBox}">

                        <!-- Контекстное меню самого списка -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Добавить новый IP"
                      Command="{Binding PlacementTarget.Tag.DataContext.PrepareAddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE109;" Foreground="Green"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=IpListBox}"/>
                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="DarkSlateGray" BorderThickness="3" CornerRadius="5" Background="Transparent" Margin="1">
                                    <!-- Контекстное меню конкретного элемента -->
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <!-- Пинг через StaticResource -->
                                            <MenuItem Header="Ping Host"
                  Command="{Binding Data.PingHost, Source={StaticResource VmProxy}}"
                  CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" Foreground="Orange"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <!-- Удаление через StaticResource -->
                                            <MenuItem Header="Удалить"
                  Command="{Binding Data.RemoveCommand, Source={StaticResource VmProxy}}"
                  CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10A;" Foreground="Red"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid Margin="5" Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="IpCol"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MaskCol"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка -->
                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE839;" FontSize="24" Foreground="LightBlue" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Колонка IP -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Обычный текст (виден по умолчанию) -->
                                            <TextBlock x:Name="TxtIp" Text="{Binding IPAddress}" FontWeight="Bold" Foreground="AliceBlue" FontSize="14"/>

                                            <!-- Поле редактирования (скрыто по умолчанию) -->
                                            <TextBox x:Name="EditIp" 
                                                     Text="{Binding IPAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="130" Background="#2D2D2D" Foreground="White" BorderBrush="Gray" Visibility="Collapsed"
                                                     Tag="{Binding ElementName=IpListBox}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" 
                                            Command="{Binding Path=Tag.DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>

                                        <!-- Колонка Маски -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center">
                                            <!-- Обычный текст (виден по умолчанию) -->
                                            <TextBlock x:Name="TxtMask" Text="{Binding SubnetMask}" Foreground="AliceBlue" FontSize="13"/>

                                            <!-- Поле редактирования (скрыто по умолчанию) -->
                                            <TextBox x:Name="EditMask" Text="{Binding SubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="130" Background="#2D2D2D" Foreground="White" BorderBrush="Gray" Visibility="Collapsed"
                                                     Tag="{Binding ElementName=IpListBox}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" 
                                            Command="{Binding Path=Tag.DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            CommandParameter="{Binding}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Триггеры, которые переключают видимость элементов при IsEditing = True -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <!-- Скрываем TextBlock-и -->
                                        <Setter TargetName="TxtIp" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="TxtMask" Property="Visibility" Value="Collapsed"/>
                                        <!-- Показываем TextBox-ы -->
                                        <Setter TargetName="EditIp" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="EditMask" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>



                </Grid>
            </Grid>
            
        </Grid>
    </Border>
</Window>
